{
  "name": "j-can-see",
  "version": "0.4.2",
  "description": "MCP server that routes images (local file / URL / clipboard / latest screenshot) to a vision model via an OpenAI-compatible or Anthropic API. For AI coding clients whose primary model has no multimodal input.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PichurChill/j-can-see.git"
  },
  "homepage": "https://github.com/PichurChill/j-can-see#readme",
  "bugs": {
    "url": "https://github.com/PichurChill/j-can-see/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "j-can-see": "dist/index.js"
  },
  "files": [
    "dist",
    "hooks",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jimp": "^1.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "image",
    "ocr",
    "claude-code",
    "codex",
    "grok"
  ]
}
